// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Profile fields (for PATCH /users/me)
  displayName       String?
  dateOfBirth       DateTime?
  heightCm          Float?
  sexAtBirth        String?
  activityLevel     String?
  dietType          String?
  restingHrBaseline Int?

  preference    Preference?
  goal          Goal?
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]

  weights      Weight[]
  measurements Measurement[]
  sleepEntries SleepEntry[]
  wellbeing    WellbeingEntry[]
  vitals       Vital[]

  medications   Medication[]
  appointments  Appointment[]
  photos        Photo[]
  medicalRecords MedicalRecord[]

  trainingPlans TrainingPlan[]
  sessions      Session[]

  meals       Meal[]
  waterIntakes WaterIntake[]
  foodItems   FoodItem[]

  habits Habit[]

  income        Income?
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  debts         Debt[]
  bills         Bill[]
  subscriptions Subscription[]

  investments       Investment[]
  assets            Asset[]
  financialGoals    FinancialGoal[]
  insurancePolicies Insurance[]
  netWorthSnapshots NetWorthSnapshot[]
}

model Preference {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  currencyCode String @default("INR")
  locale       String @default("en-IN")
  dateFormat   String @default("dd/MM/yyyy")
  units        String @default("metric")
  weekStartsOn String @default("monday")
}

model Goal {
  id                String  @id @default(uuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id])
  primaryGoal       String?
  targetWeightKg    Float?
  dailyCalories     Int?
  dailyProteinG     Int?
  dailyCarbsG       Int?
  dailyFatG         Int?
  dailyWaterMl      Int?
  dailySleepMinutes Int?
  workoutsPerWeek   Int?
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}


model Weight {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  kg        Float
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Measurement {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  site      String   // waist, chest, arm, thigh, shoulders...
  valueCm   Float
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, site])
}

model SleepEntry {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  date             DateTime
  durationMinutes  Int
  quality          Int?     // 1-5
  interruptions    Int?
  bedtime          DateTime?
  wake             DateTime?
  createdAt        DateTime @default(now())

  @@index([userId, date])
}

model WellbeingEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  mood      Int?     // 1-5
  stress    Int?
  energy    Int?
  soreness  Int?
  fatigue   Int?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Vital {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  kind       String   // "resting_heart_rate" | "blood_pressure"
  value      Int?     // used for resting_heart_rate
  systolic   Int?     // used for blood_pressure
  diastolic  Int?     // used for blood_pressure
  recordedAt DateTime @default(now())

  @@index([userId, kind, recordedAt])
}


model Medication {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  name           String
  isPrescription Boolean   @default(false)
  dosage         String?
  frequency      String?
  quantityLeft   Int?
  refillOn       DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model Appointment {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  title        String
  scheduledAt  DateTime
  provider     String?
  location     String?
  createdAt    DateTime @default(now())

  @@index([userId, scheduledAt])
}

model Photo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  storagePath String
  url       String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model MedicalRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  storagePath String
  url         String
  createdAt   DateTime @default(now())

  @@index([userId])
}


model TrainingPlan {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  name               String
  targetMuscleGroups String[]
  exercises          PlanExercise[]
  createdAt          DateTime       @default(now())

  @@index([userId])
}

model PlanExercise {
  id             String       @id @default(uuid())
  planId         String
  plan           TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name           String
  order          Int
  prescribedSets Int
  prescribedReps String       // e.g. "8-12" - kept as a string to allow ranges

  @@index([planId])
}

model Session {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  date             DateTime
  title            String
  muscles          String[]
  status           String            @default("completed") // "completed" | "skipped"
  durationMinutes  Int?
  perceivedEffort  Int?              // RPE
  exercises        SessionExercise[]
  createdAt        DateTime          @default(now())

  @@index([userId, date])
}

model SessionExercise {
  id        String      @id @default(uuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  sets      SessionSet[]
}

model SessionSet {
  id                String          @id @default(uuid())
  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  kind              String          @default("working") // "warmup" | "working"
  weightKg          Float?
  reps              Int?
  rpe               Float?
  completed         Boolean         @default(false)
}

model Meal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  slot      String   // breakfast | lunch | dinner | snack | pre_workout | post_workout
  label     String
  calories  Int?
  protein   Float?
  carbs     Float?
  fat       Float?
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, slot])
}

model WaterIntake {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model FoodItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  dietTags  String[] // e.g. ["vegetarian", "vegan", "gluten_free"]
  calories  Int?
  protein   Float?
  carbs     Float?
  fat       Float?
  createdAt DateTime @default(now())

  @@index([userId])
}


model Habit {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  name         String
  cadence      String     // "daily" | "custom_days"
  customDays   Int[]      // 0=Sunday...6=Saturday, used when cadence = custom_days
  metricType   String     // "boolean" | "count" | "duration_minutes"
  target       Int?       // used for count/duration types
  archivedAt   DateTime?
  logs         HabitLog[]
  createdAt    DateTime   @default(now())

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime
  status    String   // "done" | "skipped"
  value     Int?     // used for count/duration metric types

  @@unique([habitId, date])
  @@index([habitId, date])
}


model Income {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  monthlyNetPaise Int
  label           String?
  updatedAt       DateTime @updatedAt
}

model Account {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  name          String
  kind          String        // "savings" | "cash" | "credit_card" | ...
  institution   String?
  maskedNumber  String?
  balancePaise  Int           @default(0)
  isPrimary     Boolean       @default(false)
  limitPaise    Int?          // credit cards only
  statementDay  Int?          // credit cards only
  dueDay        Int?          // credit cards only
  transactions  Transaction[]
  createdAt     DateTime      @default(now())

  @@index([userId])
}

model Category {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  name          String
  group         String        // "Housing" | "Food" | "Transport" | ...
  isNeed        Boolean       @default(true)
  budgetPaise   Int?          // monthly budget for this category
  transactions  Transaction[]
  createdAt     DateTime      @default(now())

  @@index([userId])
}

model Transaction {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  merchant    String
  amountPaise Int
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id])
  date        DateTime
  createdAt   DateTime  @default(now())

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, accountId])
}

model Debt {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  name                String
  kind                String    // "gadget_emi" | "vehicle_loan" | "personal_loan" | "home_loan"
  lender              String?
  principalPaise      Int
  annualRatePct       Float
  termMonths          Int
  startedOn           DateTime
  emiPaise            Int
  paidMonths          Int       @default(0)
  purchasePricePaise  Int?      // gadget EMIs only
  downPaymentPaise    Int?      // gadget EMIs only
  createdAt           DateTime  @default(now())

  @@index([userId])
}

model Bill {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  amountPaise  Int
  dueDay       Int
  recurrence   String   // "monthly" | "annual"
  autopay      Boolean  @default(false)
  category     String?
  isVariable   Boolean  @default(false) // e.g. electricity
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  name             String
  amountPaise      Int
  recurrence       String   // "monthly" | "annual"
  dueDay           Int
  lastUsedDaysAgo  Int?
  createdAt        DateTime @default(now())

  @@index([userId])
}


model Investment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  name           String
  kind           String   // "mutual_fund" | "stock" | "epf" | "ppf" | ...
  units          Float
  avgCostPaise   Int
  currentNavPaise Int
  sipPaise       Int      @default(0)
  sipDay         Int?
  since          DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
}

model Asset {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  kind          String   // "vehicle" | "precious" | ...
  valuePaise    Int
  acquiredOn    DateTime
  depreciating  Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId])
}

model FinancialGoal {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  name           String
  targetPaise    Int
  savedPaise     Int       @default(0)
  targetDate     DateTime?
  priority       Int       @default(1)
  linkedAccountId String?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model Insurance {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  kind         String   // "term_life" | "health" | "vehicle"
  provider     String
  coverPaise   Int
  premiumPaise Int
  renewalOn    DateTime
  frequency    String   // "annual" | "monthly"
  createdAt    DateTime @default(now())

  @@index([userId])
}

model NetWorthSnapshot {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  date           DateTime @default(now())
  assetsPaise    Int
  liabilitiesPaise Int
  netPaise       Int

  @@index([userId, date])
}