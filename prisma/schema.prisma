// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  // Profile fields (for PATCH /users/me)
  displayName       String?
  dateOfBirth       DateTime?
  heightCm          Float?
  sexAtBirth        String?
  activityLevel     String?
  dietType          String?
  restingHrBaseline Int?

  preference    Preference?
  goal          Goal?
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]

  weights      Weight[]
  measurements Measurement[]
  sleepEntries SleepEntry[]
  wellbeing    WellbeingEntry[]
  vitals       Vital[]

  medications   Medication[]
  appointments  Appointment[]
  photos        Photo[]
  medicalRecords MedicalRecord[]

  trainingPlans TrainingPlan[]
  sessions      Session[]
}

model Preference {
  id           String @id @default(uuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  currencyCode String @default("INR")
  locale       String @default("en-IN")
  dateFormat   String @default("dd/MM/yyyy")
  units        String @default("metric")
  weekStartsOn String @default("monday")
}

model Goal {
  id                String  @id @default(uuid())
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id])
  primaryGoal       String?
  targetWeightKg    Float?
  dailyCalories     Int?
  dailyProteinG     Int?
  dailyCarbsG       Int?
  dailyFatG         Int?
  dailyWaterMl      Int?
  dailySleepMinutes Int?
  workoutsPerWeek   Int?
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}


model Weight {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  kg        Float
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Measurement {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  site      String   // waist, chest, arm, thigh, shoulders...
  valueCm   Float
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([userId, site])
}

model SleepEntry {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  date             DateTime
  durationMinutes  Int
  quality          Int?     // 1-5
  interruptions    Int?
  bedtime          DateTime?
  wake             DateTime?
  createdAt        DateTime @default(now())

  @@index([userId, date])
}

model WellbeingEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  mood      Int?     // 1-5
  stress    Int?
  energy    Int?
  soreness  Int?
  fatigue   Int?
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Vital {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  kind       String   // "resting_heart_rate" | "blood_pressure"
  value      Int?     // used for resting_heart_rate
  systolic   Int?     // used for blood_pressure
  diastolic  Int?     // used for blood_pressure
  recordedAt DateTime @default(now())

  @@index([userId, kind, recordedAt])
}


model Medication {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  name           String
  isPrescription Boolean   @default(false)
  dosage         String?
  frequency      String?
  quantityLeft   Int?
  refillOn       DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model Appointment {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  title        String
  scheduledAt  DateTime
  provider     String?
  location     String?
  createdAt    DateTime @default(now())

  @@index([userId, scheduledAt])
}

model Photo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime
  storagePath String
  url       String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model MedicalRecord {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  storagePath String
  url         String
  createdAt   DateTime @default(now())

  @@index([userId])
}


model TrainingPlan {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  name               String
  targetMuscleGroups String[]
  exercises          PlanExercise[]
  createdAt          DateTime       @default(now())

  @@index([userId])
}

model PlanExercise {
  id             String       @id @default(uuid())
  planId         String
  plan           TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name           String
  order          Int
  prescribedSets Int
  prescribedReps String       // e.g. "8-12" - kept as a string to allow ranges

  @@index([planId])
}

model Session {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  date             DateTime
  title            String
  muscles          String[]
  status           String            @default("completed") // "completed" | "skipped"
  durationMinutes  Int?
  perceivedEffort  Int?              // RPE
  exercises        SessionExercise[]
  createdAt        DateTime          @default(now())

  @@index([userId, date])
}

model SessionExercise {
  id        String      @id @default(uuid())
  sessionId String
  session   Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  sets      SessionSet[]
}

model SessionSet {
  id                String          @id @default(uuid())
  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  kind              String          @default("working") // "warmup" | "working"
  weightKg          Float?
  reps              Int?
  rpe               Float?
  completed         Boolean         @default(false)
}

